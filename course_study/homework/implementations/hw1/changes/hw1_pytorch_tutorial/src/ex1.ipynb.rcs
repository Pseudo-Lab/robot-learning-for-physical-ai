def make_linspace(
    start: float,
    end: float,
    steps: int,
    dtype: torch.dtype | None = None,
    device: torch.device | str | None = None,
) -> torch.Tensor:
    """Create evenly spaced values from start to end, inclusive."""
    return torch.linspace(start, end, steps, dtype=dtype, device=device)

