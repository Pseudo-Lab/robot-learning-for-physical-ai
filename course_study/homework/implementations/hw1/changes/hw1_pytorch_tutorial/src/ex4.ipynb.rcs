patch_size, d_model, n_heads, n_layers, d_ff, dropout = (
    (4, 32, 4, 1, 128, 0.1) if smoke_mode else (4, 64, 4, 2, 256, 0.1)
)
runs = ["ffn", "geglu", "swiglu"]
seeds = [0, 1] if smoke_mode else [0, 1, 2]
results = []
for seed in seeds:
    cfg = replace(base_cfg, seed=seed)
    for kind in runs:
        torch.manual_seed(seed)
        model = TinyViT(patch_size, d_model, n_heads, n_layers, d_ff, dropout, kind)
        print(
            f"\nRun: {kind} | seed={seed} | parameters={sum(p.numel() for p in model.parameters()):,}"
        )
        results.append(train_one_run(kind, model, train_loader, test_loader, cfg))
expected_runs = len(runs) * len(seeds)
if len(results) != expected_runs:
    raise RuntimeError(f"Expected {expected_runs} ablation runs, got {len(results)}")
