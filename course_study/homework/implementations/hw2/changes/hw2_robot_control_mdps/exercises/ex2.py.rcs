    start = np.asarray(start)
    end = np.asarray(end)
    s = np.linspace(0.0, 1.0, num_points)
    time_scale = 10.0 * s**3 - 15.0 * s**4 + 6.0 * s**5
    return start + np.expand_dims(time_scale, axis=-1) * (end - start)
