    rng = np.random if rng is None else rng
    offset = np.array(
        [
            rng.uniform(0.2, 0.4),
            rng.uniform(-0.2, 0.2),
            rng.uniform(0.1, 0.4),
        ]
    )
    return np.asarray(base_pos) + offset
