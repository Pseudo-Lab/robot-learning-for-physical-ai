    # Solve on separate data before enabling the physics callback: IK must not
    # overwrite the simulated robot's velocities on every physics step.
    ik_data = mujoco.MjData(model)
    # A bent-arm seed selects the feasible elbow-up branch for the path.
    ik_data.qpos[:] = model.jnt_range.mean(axis=1)
    ik_data.qpos[-1] = data.qpos[-1]
    target_joint_positions = []
    for waypoint in total_waypoints:
        target_qpos = ik_track(model, ik_data, site_name, waypoint)
        target_joint_positions.append(target_qpos)
        ik_data.qpos[:] = target_qpos
    target_joint_positions = np.asarray(target_joint_positions)

