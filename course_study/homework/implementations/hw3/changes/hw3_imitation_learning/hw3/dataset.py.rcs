def target_offset(
    cubes_xyz: np.ndarray, goal: np.ndarray, ee_xyz: np.ndarray
) -> np.ndarray:
    """Select the requested colour before measuring its offset from the gripper."""
    return (cubes_xyz * goal[..., :, None]).sum(axis=-2) - ee_xyz


